# =============================================================================
# DealPass — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in ONLY the values you actually have.
# Every connector stays DISABLED until its credentials are present and the
# provider has approved your account. Never commit a filled-in file.
#
# Rule: variables prefixed NEXT_PUBLIC_ are shipped to the browser.
#       Everything else is server-only. Never put a secret in NEXT_PUBLIC_*.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=DealPass
NEXT_PUBLIC_DEFAULT_LANGUAGE=fr
NEXT_PUBLIC_DEFAULT_COUNTRY=DZ
NEXT_PUBLIC_DEFAULT_CURRENCY=DZD

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PRODUCTION (Supabase Postgres): set DATABASE_URL and the app uses the `pg`
# driver. Get it from Supabase → Project Settings → Database → Connection
# string → URI (use the "Transaction pooler" URI on serverless platforms).
DATABASE_URL=

# Supabase project credentials (auth, storage, realtime).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row-Level Security. Never expose to the browser,
# never import it from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# LOCAL DEVELOPMENT: if DATABASE_URL is empty the app falls back to PGlite —
# real PostgreSQL compiled to WebAssembly, stored under .data/pglite.
# Zero setup, and it runs the exact same SQL migrations as Supabase.
PGLITE_DATA_DIR=.data/pglite

# -----------------------------------------------------------------------------
# AFFILIATE NETWORKS  (leave blank = connector disabled)
# -----------------------------------------------------------------------------
# Awin — dashboard → Account → API tokens → "API Token"
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# Impact.com — Settings → API / "Account SID" + "Auth Token" + "API Secret"
IMPACT_ACCOUNT_ID=
IMPACT_API_KEY=
IMPACT_API_SECRET=

# CJ Affiliate — Developers → Personal Access Tokens (needs "company id")
CJ_COMPANY_ID=
CJ_API_TOKEN=

# Rakuten Advertising — Publishers → Tools → Web Services / API token
RAKUTEN_API_KEY=

# Travelpayouts — Account → API token (Travelpayouts / Aviasales / Hotellook)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Feedico — only if you hold an approved account with API access
FEEDICO_API_KEY=

# -----------------------------------------------------------------------------
# SHOPPING & PRODUCT PLATFORMS
# -----------------------------------------------------------------------------
# Amazon Associates + Product Advertising API v5 (PA-API is approval-gated)
AMAZON_ASSOCIATE_TAG=
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=www.amazon.fr

# eBay Partner Network — Developer Program → keys + your EPID campaign id
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# AliExpress Affiliate (Portals API) — app key/secret from the open platform
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

TEMU_AFFILIATE_ID=
WALMART_AFFILIATE_ID=
WALMART_CONSUMER_ID=
SHEIN_AFFILIATE_ID=
IHERB_AFFILIATE_ID=
UDEMY_AFFILIATE_ID=
CLICKBANK_ACCOUNT_ID=
CLICKBANK_API_KEY=

# -----------------------------------------------------------------------------
# TRAVEL PLATFORMS
# -----------------------------------------------------------------------------
TRIP_COM_AFFILIATE_ID=
EXPEDIA_AFFILIATE_ID=
EXPEDIA_API_KEY=
BOOKING_COM_AFFILIATE_ID=
AGODA_AFFILIATE_ID=
KLOOK_AFFILIATE_ID=
DISCOVERCARS_AFFILIATE_ID=

# -----------------------------------------------------------------------------
# BREVO (newsletter / transactional email)
# -----------------------------------------------------------------------------
# Account → SMTP & API → API keys
BREVO_API_KEY=
# Lists → create one list for confirmed subscribers, one for pending double opt-in
BREVO_CONFIRMED_LIST_ID=
BREVO_UNCONFIRMED_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DealPass

# -----------------------------------------------------------------------------
# AUTOMATION  (n8n + internal endpoints)
# -----------------------------------------------------------------------------
# Shared token the eight n8n workflows present in the
# X-DealPass-Internal-Token header when they call /api/internal/*.
# Required: until it is set to at least 24 characters, every automation
# endpoint returns 401. Generate one with:  openssl rand -hex 32
INTERNAL_API_TOKEN=

# Where the daily operations report and error escalations are emailed.
OPS_ALERT_EMAIL=

N8N_BASE_URL=
N8N_API_KEY=
# Shared secret the app and n8n both know — used to sign/verify webhooks
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI (editorial text, translation, classification — never facts)
# -----------------------------------------------------------------------------
# openai | anthropic | mistral | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# -----------------------------------------------------------------------------
# MONITORING & ALERTING
# -----------------------------------------------------------------------------
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Bearer token required by /api/cron/* and /api/admin/jobs/*
CRON_SECRET=
# HMAC key for signing outbound webhooks and unsubscribe links
WEBHOOK_SIGNING_SECRET=
# 32-byte base64 key used to derive privacy-preserving click hashes
DATA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# BOT PROTECTION (optional but recommended on public forms)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Set to "false" to hide every offer that came from the demo connector.
# Leave "true" on a fresh install so the site is populated before you have
# any approved affiliate account.
ENABLE_DEMO_CONNECTOR=true

{
  "name": "dealpass",
  "version": "0.1.0",
  "private": true,
  "description": "DealPass — multilingual affiliate coupon & deals platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:server": "tsx --env-file-if-exists=.env.local scripts/pglite-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
